{
  "name": "paseo-observatory",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time observability for Paseo agent runs, model usage, and backend runtimes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesunwave/paseo-observatory.git"
  },
  "homepage": "https://github.com/thesunwave/paseo-observatory#readme",
  "bugs": {
    "url": "https://github.com/thesunwave/paseo-observatory/issues"
  },
  "keywords": [
    "paseo",
    "observability",
    "agents",
    "claude-code",
    "opencode",
    "token-usage"
  ],
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --test spike/test/*.test.mjs src/test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "release:check": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.9.2",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  }
}
